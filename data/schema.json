{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AQuIRE: Awesome Quantum Information Research Explorer",
  "type": "object",
  "required": [
    "title",
    "snapshot_date",
    "counts",
    "taxonomy",
    "paths",
    "methods",
    "resources"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "counts": {
      "type": "object"
    },
    "taxonomy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "goal",
          "steps",
          "output"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "topic_id",
                "text"
              ],
              "properties": {
                "topic_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "heading",
          "text"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "prerequisites",
        "assessment",
        "topics"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "prerequisites": {
          "type": "string"
        },
        "assessment": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/topic"
          }
        }
      }
    },
    "topic": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "query",
        "pattern",
        "subcategories"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "subcategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "id",
        "title",
        "authors",
        "year",
        "date",
        "type",
        "metadata_type",
        "venue",
        "conference",
        "publisher",
        "volume",
        "issue",
        "pages",
        "article_number",
        "doi",
        "url",
        "source",
        "metadata_url",
        "retrieved",
        "domain",
        "topic",
        "topic_id",
        "subcategories",
        "classification",
        "assignments",
        "discovery_query",
        "score",
        "access",
        "landing_check",
        "link_status",
        "isbn",
        "core"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q[0-9]{4,}$"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1000,
          "maximum": 9999
        },
        "date": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "metadata_type": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "conference": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "volume": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        },
        "pages": {
          "type": "string"
        },
        "article_number": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "source": {
          "type": "string"
        },
        "metadata_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "retrieved": {
          "type": "string",
          "format": "date"
        },
        "domain": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "topic_id": {
          "type": "string"
        },
        "subcategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classification": {
          "type": "string"
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "domain",
              "topic",
              "topic_id"
            ],
            "properties": {
              "domain": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "topic_id": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "title_pattern": {
                "type": "string"
              }
            }
          }
        },
        "discovery_query": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "access": {
          "type": "string"
        },
        "landing_check": {
          "type": "string"
        },
        "link_status": {
          "enum": [
            "Registered DOI",
            "Page retrieved"
          ]
        },
        "isbn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "core": {
          "type": "boolean"
        }
      }
    }
  }
}
